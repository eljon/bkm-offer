rules_version = '2';

// ============================================================
//  Cloud Firestore security rules for Offer Maker
//  Collections used by the app: products, offers, settings
//  (product images and the offer logo are stored inline as data
//   URIs inside these documents — no Firebase Storage needed).
//
//  Paste these into: Firebase console → Firestore Database → Rules → Publish.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    //  DEFAULT: public access (no login required)
    //  This app ships without user sign-in, so these rules let
    //  ANYONE who has your Firebase config read and write these
    //  three collections. That is fine for a private/low-risk
    //  catalog, but it is NOT secure for sensitive data — anyone
    //  who views the site could edit or delete your offers.
    //  To lock it down, enable Firebase Authentication and switch
    //  to the AUTHENTICATED block below.
    // ------------------------------------------------------------
    match /products/{id} { allow read, write: if true; }
    match /offers/{id}   { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }

    // Everything else is denied.
    match /{document=**} { allow read, write: if false; }

    // ------------------------------------------------------------
    //  RECOMMENDED (AUTHENTICATED): require a signed-in staff user.
    //  1) Firebase console → Authentication → enable a provider
    //     (e.g. Email/Password), and wire sign-in into the app.
    //  2) Replace the three matches above with these:
    //
    //  match /products/{id} {
    //    allow read: if true;                 // offers can be shown publicly
    //    allow write: if request.auth != null; // only signed-in staff edit
    //  }
    //  match /offers/{id} {
    //    allow read: if true;
    //    allow write: if request.auth != null;
    //  }
    //  match /settings/{id} {
    //    allow read: if true;
    //    allow write: if request.auth != null;
    //  }
    // ------------------------------------------------------------
  }
}
